# Copy this file to .env and fill in what you have.
# The defaults below are the FREE stack: local embeddings/reranking (no key needed)
# + Groq's free-tier LLM API for generation (no credit card required to sign up).

# ---- Generation LLM ----
# Which provider generation/llm_client.py should call: groq | gemini | openai | anthropic
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys (free tier, no card required)
# Check https://console.groq.com/docs/models for the current model list — Groq
# retires models fairly often (llama-3.3-70b-versatile was removed in 2026).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative free option: https://aistudio.google.com/apikey (free tier, no card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional paid providers, only used if LLM_PROVIDER is set to them
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Embeddings (local, free — no key needed by default) ----
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Only used if you switch EMBEDDING_PROVIDER to voyage or openai later
VOYAGE_API_KEY=

# ---- Reranking (local, free — no key needed by default) ----
RERANK_PROVIDER=local
LOCAL_RERANK_MODEL=BAAI/bge-reranker-base
# Only used if you switch RERANK_PROVIDER to cohere later
COHERE_API_KEY=

# ---- Vector store ----
CHROMA_PERSIST_DIR=./data/chroma
# Silence ChromaDB's telemetry (its posthog client errors noisily on newer versions)
ANONYMIZED_TELEMETRY=False

# ---- Retrieval tuning ----
RETRIEVAL_TOP_K=25
RERANK_TOP_K=5
CONFIDENCE_THRESHOLD=0.15
